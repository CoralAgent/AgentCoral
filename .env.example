# ── CORAL ──────────────────────────────────────────────────────────────
# Copy to .env and fill what you need. Everything is optional:
# with zero keys CORAL still runs, in paper mode, with a deterministic
# reasoning fallback (see packages/core/src/agent/engine.ts).

# Where the reef lives. Default: ./.coral
CORAL_HOME=

# paper | live   — live refuses to trade unless limits are explicitly raised
CORAL_MODE=paper

# Reasoning provider: anthropic | openai | google | xai | none
CORAL_LLM=anthropic
CORAL_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=

# Robinhood Trading MCP (OAuth-hosted). Token is only needed for live reads/orders.
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_MCP_TOKEN=

# Robinhood Chain (EVM L2, chainId 4663). Public endpoint, no key required.
ROBINHOOD_CHAIN_RPC=https://rpc.mainnet.chain.robinhood.com

# Oak Agent Kit MCP — local stdio bridge for on-chain reads and gated swaps.
# Requires @oakagentkit/addon installed (npm i -g @oakagentkit/addon) so `oak` is on PATH.
OAK_MCP_COMMAND=oak mcp

# Visitor wallets on /dapp — Privy embedded wallets. Get an App ID at
# dashboard.privy.io, enable embedded wallets, then set this in apps/web/.env.local
# (it is a NEXT_PUBLIC_ var, inlined into the client bundle — it is an app ID,
# not a secret). Leave empty and /dapp shows setup instructions instead.
NEXT_PUBLIC_PRIVY_APP_ID=

# The CORAL contract address shown under the hero tagline. Set it in
# apps/web/.env.local (NEXT_PUBLIC_ vars are inlined into the client bundle).
# Leave empty and the hero prints "set NEXT_PUBLIC_CORAL_CA" instead of a
# plausible-looking placeholder: a wrong CA is the most expensive typo in this
# project.
NEXT_PUBLIC_CORAL_CA=

# Optional dedicated wallet for direct on-chain signing (send/transfer only —
# swaps still go through Oak's gated path). Plaintext key lives here, not in
# the OS keychain, so use a low-value wallet funded only with what the agent
# may spend. Leave empty to disable.
CORAL_SIGNER_KEY=
